# Copie ce fichier en .env et ajuste les valeurs.

# --- PostgreSQL ---
DB_NAME=dofus
DB_USER=dofus
DB_PASSWORD=change-me
DB_PORT=5432

# --- Capture réseau (backend) ---
# Interface de capture (vide = auto Scapy). Ex Linux : eth0 / wlan0
CAPTURE_INTERFACE=
# Filtre BPF. Dofus Retro officiel = trafic EN CLAIR sur le port 443
# (protocole texte custom, pas TLS). Le décodage ne garde que les messages 'EL'.
CAPTURE_BPF_FILTER=tcp port 443
# Optionnel : chemin d'un fichier où archiver les messages EL bruts (debug).
CAPTURE_DEBUG_DUMP=

# --- Suivi live (watcher API) ---
# Dossier surveillé (côté conteneur) où dumpcap dépose les captures. Vide = off.
# Active l'auto-sync banque + prix HDV. data/live (hôte) est monté sur /srv/data/live.
LIVE_CAPTURE_DIR=/srv/data/live
